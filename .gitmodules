[submodule "firmware/pico-sdk"]
	path = firmware/pico-sdk
	url = https://github.com/raspberrypi/pico-sdk.git
[submodule "firmware/libsmb2"]
	path = firmware/libsmb2
	url = https://github.com/yunkya2/libsmb2.git
[submodule "firmware/FreeRTOS-Kernel"]
	path = firmware/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "firmware/x68kserremote"]
	path = firmware/x68kserremote
	url = https://github.com/yunkya2/x68kserremote.git
[submodule "firmware/lib/FatFs_SD"]
	path = firmware/lib/FatFs_SD
	url = https://github.com/carlk3/no-OS-FatFS-SD-SDIO-SPI-RPi-Pico.git
